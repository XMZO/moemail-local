[Unit]
Description=Run MoeMail maintenance from validated runtime configuration
After=moemail.service
Wants=moemail.service
OnFailure=moemail-alert@%n.service

[Service]
Type=simple
User=moemail
Group=moemail
WorkingDirectory=/opt/moemail
ExecStart=/usr/bin/pnpm scheduler:local
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
