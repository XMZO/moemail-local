log_format moemail_json escape=json
  '{"time":"$time_iso8601","status":$status,"uri":"$request_uri",'
  '"method":"$request_method","request_time":$request_time,'
  '"remote_addr":"$remote_addr","bytes_sent":$bytes_sent}';

server {
  listen 443 ssl http2;
  server_name mail.example.com;

  ssl_certificate /etc/letsencrypt/live/mail.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/mail.example.com/privkey.pem;
  client_max_body_size 1m;

  access_log /var/log/nginx/moemail-access.json moemail_json;

  location = /api/internal/email {
    client_max_body_size 27m;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-MoeMail-Client-IP $remote_addr;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-MoeMail-Client-IP $remote_addr;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
  }
}

server {
  listen 80;
  server_name mail.example.com;
  return 301 https://$host$request_uri;
}
